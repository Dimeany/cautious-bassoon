# This is the IMPRESS environment file ...
# Last updated 2026-05-18 Liam

# Flight User
USER="sat"
ROOT_DIR="/SAT"
MISSION="impress"

# Setup
SUBSYSTEMS="ADCS CDH CMD DET DET-SCI EPS GPS JOUR MISC"

# For Detector
DET_SERVICE_PORT=61999
HAFX_C1_SCI_PORT=61000
HAFX_C1_DBG_PORT=61001
HAFX_M1_SCI_PORT=61002
HAFX_M1_DBG_PORT=61003
HAFX_M5_SCI_PORT=61004
HAFX_M5_DBG_PORT=61005
HAFX_X1_SCI_PORT=61006
HAFX_X1_DBG_PORT=61007
X123_SCI_PORT=61008
X123_DBG_PORT=61009
DET_HEALTH_PORT=61010

# Serial numbers for HaFX detectors
HAFX_C1_SERIAL="55FD9A8F4A344E5120202041131E05FF"
HAFX_M1_SERIAL="7A65CD294A344E51202020412B2404FF"
HAFX_M5_SERIAL=undefined
HAFX_X1_SERIAL=undefined

# For ADCS
ADCS_COMMAND_PORT=53000
ADCS_UDPCAPTURE_PORT=53001
ADCS_COMMISSION_PORT=53004
ADCS_HP_DELAY_S=10

# For CDH
CDH_COMMAND_PORT=51000
CDH_UDPCAPTURE_PORT=51001
CDH_HEALTH_DATA_PORT=51002
CDH_HP_DELAY_S=10

#For EPS
EPS_COMMAND_PORT=52000
EPS_UDPCAPTURE_PORT=52001
EPS_EXECUTABLE_ARGS="-m impress -c 2"
EPS_HP_DELAY_S=10

# P4 PDU hardware channel identifiers.  HW channels zero based 0-7
# Documentation and diagrams show 1 based channels 1-8
# CPU is physical channel 1 but shown as channel 2 in diagrams
EPS_FCB_CH=1
EPS_GPS_CH=3
EPS_DET_C1_CH=10
EPS_DET_M1_CH=9
EPS_DET_M5_CH=11
EPS_DET_X1_CH=8
EPS_ADCS_1_CH=1
EPS_ADCS_2_CH=5

#For GPS
GPS_COMMAND_PORT=55000
GPS_UDPCAPTURE_PORT=55001
GPS_PPS_CONFIG_PORT=55004
GPS_NMEA_SOCKET_PORT=2947
GPS_HP_DELAY_S=10

GPS_COM_INTERFACE="COM1"

#For COMMS
COMMS_LIVE_PORT=50000
COMMS_CDH_PORT=50001
COMMS_COMMAND_PORT=50002
COMMS_DICE_FORWARD_PORT=50005
COMMS_NORM_PORT=50007
COMMS_BFT_RECEIVE_PORT=50015

COMMS_SERVICE_ARGS="-s /dev/serial0 -b 921600"
COMMS_EXECUTABLE_ARGS="-l 127.0.0.1:50001 -n 127.0.0.1:50002 -M 50003 -N 50003 -s /dev/ttyAMA0 -b 115200 -p"

# For CMD
CMD_COMMAND_PORT=56000
CMD_EXECUTABLE_ARGS="-f"

# For ADCS
ADCS_EXECUTABLE_ARGS=""
