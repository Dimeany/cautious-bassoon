# This is the EXACT environment file ...
# Last updated 2026-05-22 Liam

# Flight User
USER="sat"
ROOT_DIR="/SAT"
MISSION="exact"

# Setup
SUBSYSTEMS="CDH CMD DET DET-SCI EPS GPS JOUR MISC"

# For Detector
DET_SERVICE_PORT=61999
DET_IP_ADDRESS=127.0.0.1

HAFX_C1_SCI_PORT=61000
HAFX_C1_SCI_BASE=hafx-nrl-list-c1
HAFX_C1_SCI_TIME=300
HAFX_C1_SCI_IDLE=300

HAFX_C1_DBG_PORT=61001
HAFX_C1_DBG_BASE=hafx-debug-c1
HAFX_C1_DBG_TIME=300
HAFX_C1_DBG_IDLE=300
HAFX_C1_DBG_MAXF=60000

HAFX_M1_SCI_PORT=61002
HAFX_M1_SCI_BASE=hafx-nrl-list-m1
HAFX_M1_SCI_TIME=300
HAFX_M1_SCI_IDLE=300

HAFX_M1_DBG_PORT=61003
HAFX_M1_DBG_BASE=hafx-debug-m1
HAFX_M1_DBG_TIME=300
HAFX_M1_DBG_IDLE=300
HAFX_M1_DBG_MAXF=60000

HAFX_M5_SCI_PORT=61004
HAFX_M5_SCI_BASE=hafx-nrl-list-m5
HAFX_M5_SCI_TIME=300
HAFX_M5_SCI_IDLE=300

HAFX_M5_DBG_PORT=61005
HAFX_M5_DBG_BASE=hafx-debug-m5
HAFX_M5_DBG_TIME=300
HAFX_M5_DBG_IDLE=300
HAFX_M5_DBG_MAXF=60000

HAFX_X1_SCI_PORT=61006
HAFX_X1_SCI_BASE=hafx-nrl-list-x1
HAFX_X1_SCI_TIME=300
HAFX_X1_SCI_IDLE=300

HAFX_X1_DBG_PORT=61007
HAFX_X1_DBG_BASE=hafx-debug-x1
HAFX_X1_DBG_TIME=300
HAFX_X1_DBG_IDLE=300
HAFX_X1_DBG_MAXF=60000

X123_SCI_PORT=61008
X123_SCI_BASE=x123-sci
X123_SCI_TIME=300
X123_SCI_IDLE=300

X123_DBG_PORT=61009
X123_DBG_BASE=x123-debug
X123_DBG_TIME=300
X123_DBG_IDLE=300
X123_DBG_MAXF=64000

# Serial numbers for HaFX detectors (A2, A3, A1, A4)
HAFX_C1_SERIAL="FB0BAEC74A344E51202020410C2605FF"
HAFX_M1_SERIAL="5D5AD16D4A344E5120202041120A05FF"
HAFX_M5_SERIAL="791068354A344E51202020410B0A05FF"
# HAFX_X1_SERIAL="EC254EEB4A344E5120202041122C05FF"
HAFX_X1_SERIAL=""

# For Detector Health
DET_HEALTH_PORT=61010
DET_UC_BASE="det"
DET_UC_TIME=3600
DET_UC_IDLE=300
DET_HEALTH_UC_FRWD=127.0.0.1:51002

# For CDH
CDH_COMMAND_PORT=51000
CDH_HEALTH_DATA_PORT=51002
CDH_HP_DELAY_S=0

CDH_UC_PORT=51001
CDH_UC_BASE=cdh
CDH_UC_TIME=3600
CDH_UC_IDLE=1200

#For EPS
EPS_COMMAND_PORT=52000
EPS_EXECUTABLE_ARGS="-e"
EPS_HP_DELAY_S=1

EPS_UC_PORT=52001
EPS_UC_BASE=eps
EPS_UC_TIME=3600
EPS_UC_IDLE=1200
EPS_UC_FRWD=127.0.0.1:51002

# P4 PDU hardware channel identifiers.  HW channels zero based 0-7
# Documentation and diagrams show 1 based channels 1-8
# CPU is physical channel 1 but shown as channel 2 in diagrams
EPS_FCB_CH=1
EPS_GPS_CH=3

#For GPS
GPS_COMMAND_PORT=55000
GPS_UDPCAPTURE_PORT=55001
GPS_PPS_CONFIG_PORT=55004
GPS_NMEA_SOCKET_PORT=2947
GPS_HP_DELAY_S=10

GPS_UC_PORT=55001
GPS_UC_BASE=gps
GPS_UC_TIME=3600
GPS_UC_IDLE=1200
GPS_UC_FRWD=127.0.0.1:51002

GPS_COM_INTERFACE="COM2"

#For COMMS
COMMS_LIVE_PORT=50000
COMMS_CDH_PORT=50001
COMMS_COMMAND_PORT=50002
COMMS_DICE_FORWARD_PORT=50005
COMMS_NORM_PORT=50007
COMMS_BFT_RECEIVE_PORT=50015

# For CMD
CMD_COMMAND_PORT=56000
CMD_EXECUTABLE_ARGS="-f"

# For NORM
NORM_ADDR=127.0.0.1/50007
NORM_HOTD=/SAT/HOT
NORM_RATE=400000
NORM_SEGM=1024
