[Unit]
Description=Calls det-controller to start DET service
After=network.target det-udpcapture-health.service det-udpcapture-x123-sci.service det-udpcapture-x123-debug.service det-udpcapture-hafx-sci-c1.service det-udpcapture-hafx-sci-m1.service det-udpcapture-hafx-sci-m5.service det-udpcapture-hafx-sci-x1.service det-udpcapture-hafx-debug-c1.service det-udpcapture-hafx-debug-m1.service det-udpcapture-hafx-debug-m5.service det-udpcapture-hafx-debug-x1.service
PartOf=det-parent.target

[Service]
Type=simple
Restart=always
RestartSec=1
User=sat
EnvironmentFile=/etc/environment
ExecStart=det-controller

[Install]
WantedBy=multi-user.target
