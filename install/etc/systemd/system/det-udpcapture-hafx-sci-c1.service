[Unit]
Description=UDP Capture Service for HaFX science data from c1 detector
After=network.target
PartOf=det-parent.target

[Service]
Type=notify
Restart=always
RestartSec=1
User=sat
WorkingDirectory=/SAT/LIVE/DET-SCI/
EnvironmentFile=/etc/environment
ExecStart=udp_capture -l $HAFX_C1_SCI_PORT -b $HAFX_C1_SCI_BASE -T $HAFX_C1_SCI_TIME -t $HAFX_C1_SCI_IDLE -p udp_post_process

[Install]
WantedBy=multi-user.target
